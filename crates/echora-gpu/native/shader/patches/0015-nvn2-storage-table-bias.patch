diff --git a/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp b/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
--- a/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
+++ b/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
@@ -1296,9 +1296,14 @@
                            const TrackingConditions& conditions) {
     // NVN puts storage buffers in a specific range, we have to bias towards these addresses to
     // avoid getting false positives
+    // NVN2 (Switch 2) driver tables put a program's storage buffers right
+    // after its root tables and uniform buffers, from 0x10 on (0x40 in a
+    // compute program with no pushed constants), not from 0x100 as NVN1
+    // did: the whole table is searched, or an address built from a c0
+    // pointer plus a c1 offset is taken for a c1 pointer.
     static constexpr Bias nvn_bias{
         .index = 0,
-        .offset_begin = 0x100,
+        .offset_begin = 0x10,
         .offset_end = 0x700,
         .alignment = 16,
     };
